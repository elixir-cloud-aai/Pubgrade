# Ignore Git- and GitHub-specific files and dirs
.git
.github
.gitignore

# Remove all docs but README.md from root directory
*.md
!README*.md

# Ignore build-specific files and dirs
**/*.egg-info
src
venv/
# Not needed at runtime
helm/
docs/
external/
mkdocs.yml
site/

# Never put secrets into the image
**/.env*
!**/.env.example
.venv*
# A deployment's configuration, with its tokens (see the README)
/config.yaml

# Test reports
reports/
