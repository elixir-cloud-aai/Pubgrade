# Only send the files that the image of the app (`Dockerfile`) needs to the
# build context; the updater's image (`build-complete-updater/Dockerfile`)
# copies its own directory
*
!pubgrade/
!requirements.txt
!build-complete-updater/

# Exclude caches and local files within the included paths
**/__pycache__
**/*.py[cod]
**/*.egg-info
# Never put secrets into the image, also not within the included paths; a
# deployment's configuration has its tokens (see the README)
**/.env*
**/*.env
**/*.pem
**/*.key
**/.git-credentials
**/.netrc
**/credentials*.json
